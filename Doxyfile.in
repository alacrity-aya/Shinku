# Doxygen configuration for Shinku

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"

OUTPUT_DIRECTORY       = "@OUTPUT_DIR@"
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = "@INPUT_DIR@"
FILE_PATTERNS          = *.c *.cc *.cpp *.h *.hpp
RECURSIVE              = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO

# doxygen-awesome-css theme (sidebar-only layout)
# See: https://github.com/jothepro/doxygen-awesome-css
HTML_EXTRA_STYLESHEET  = "@DOXYGEN_AWESOME_CSS_DIR@/doxygen-awesome.css" \
                         "@DOXYGEN_AWESOME_CSS_DIR@/doxygen-awesome-sidebar-only.css"
HTML_COLORSTYLE        = LIGHT

# Sidebar-only layout configuration (per doxygen-awesome-css docs)
# WARNING: FULL_SIDEBAR must be NO - the theme is NOT compatible with FULL_SIDEBAR = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# Graphviz (dot) configuration
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0

# Graph generation options
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

# Graph appearance
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0
DOT_MULTI_TARGETS      = YES
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES
